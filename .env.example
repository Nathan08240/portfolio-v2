# Local : cd backend && node --env-file=../.env index.js
PORT=3000
# Defaut : backend/data/database.sqlite en local, /app/data/database.sqlite en Docker
DB_PATH=
# Obligatoire en production (NODE_ENV=production) : openssl rand -hex 32
JWT_SECRET=
# Mot de passe du compte "admin", cree seulement si la base n'a aucun utilisateur
ADMIN_PASSWORD=
